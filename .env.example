SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only. Bypasses Row Level Security — never expose this to the client, never commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional. Minimum cohort size before the lecturer heatmap shows any aggregate. Defaults to 8.
LECTURER_MIN_COHORT="8"

# Server-only. Encrypts saved Brightspace calendar feed URLs at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ICS_URL_ENCRYPTION_KEY="your-32-byte-hex-key"
